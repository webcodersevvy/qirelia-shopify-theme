{% doc %}
  Renders an architectural QIRÉLIA fragrance card driven by live Shopify product & metafield data.

  @param {object} [product] - Shopify product drop
  @param {string} [card_style] - Layout variant: home | catalogue | shop
  @param {boolean} [show_reserve_badge] - Show Reserve edition stamp above title
  @param {boolean} [show_sensory_lead] - Show sensory lead line (catalogue style)
{% enddoc %}
{%- liquid
  assign style_mod = card_style | default: 'home'
  assign wrapper_class = 'q-card'
  if style_mod == 'catalogue'
    assign wrapper_class = 'q-card q-card--catalogue'
  elsif style_mod == 'shop'
    assign wrapper_class = 'q-card q-card--shop'
  endif

  assign sizes_attr = '(max-width: 809px) 100vw, 50vw'
  if style_mod == 'shop'
    assign sizes_attr = '(max-width: 809px) 100vw, (max-width: 1023px) 50vw, 33vw'
  endif
-%}

{%- if product != blank -%}
  {%- liquid
    assign badge_text = product.metafields.qirelia.edition_stamp.value
    assign short_meta = product.metafields.qirelia.card_short_meta.value | default: product.type
    assign formats_meta = product.metafields.qirelia.formats_meta.value | default: short_meta
    assign sensory_lead = product.metafields.qirelia.sensory_lead.value
    assign card_alt = product.featured_media.alt | default: product.title
    if show_reserve_badge and badge_text == blank
      assign badge_text = product.metafields.qirelia.concentration.value
    endif
  -%}
  <a href="{{ product.url }}" class="{{ wrapper_class }}">
    <div class="q-card__media">
      {% render 'media-image',
        image: product.featured_media,
        alt: card_alt,
        sizes: sizes_attr
      %}
    </div>

    {%- if show_reserve_badge and badge_text != blank -%}
      <span class="q-badge-reserve">{{ badge_text }}</span>
    {%- endif -%}

    <div class="q-card__meta">
      <div class="q-card__title-row">
        <h3 class="q-card__title">{{ product.title }}</h3>
        <span class="q-card__price q-tnum">
          {%- if style_mod == 'catalogue' and settings.show_currency_code -%}
            {{ product.price_min | money_without_trailing_zeros }} {{ cart.currency.iso_code }}
          {%- else -%}
            {{ product.price_min | money_without_trailing_zeros }}
          {%- endif -%}
        </span>
      </div>

      {%- if style_mod == 'catalogue' -%}
        {%- if show_sensory_lead and sensory_lead != blank -%}
          <p class="q-body" style="margin: 0; color: var(--q-dark-03);">{{ sensory_lead }}</p>
        {%- endif -%}
        {%- if formats_meta != blank -%}
          <p class="q-mono-spec" style="margin: 0;">{{ formats_meta }}</p>
        {%- endif -%}
      {%- elsif short_meta != blank -%}
        <p class="q-mono-spec" style="margin: 0;">{{ short_meta }}</p>
      {%- endif -%}
    </div>
  </a>
{%- else -%}
  <div class="{{ wrapper_class }}">
    <div class="q-card__media">
      {{ 'product-1' | placeholder_svg_tag }}
    </div>
    <div class="q-card__meta">
      <div class="q-card__title-row">
        <h3 class="q-card__title">{{ 'collections.general.empty' | t }}</h3>
      </div>
    </div>
  </div>
{%- endif -%}
