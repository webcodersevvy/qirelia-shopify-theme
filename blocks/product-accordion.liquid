{%- liquid
  assign target_product = block.settings.product | default: product
  assign body_html = block.settings.content

  case block.settings.source
    when 'story'
      assign meta_story = target_product.metafields.qirelia.story_wear_summary.value
      if meta_story != blank
        assign body_html = meta_story
      elsif target_product.description != blank
        assign body_html = target_product.description
      endif
    when 'inci'
      assign meta_inci = target_product.metafields.qirelia.inci_care.value
      if meta_inci != blank
        assign body_html = meta_inci
      endif
    when 'shipping'
      assign meta_shipping = target_product.metafields.qirelia.shipping_note.value
      if meta_shipping != blank
        assign body_html = meta_shipping
      elsif shop.shipping_policy != blank and shop.shipping_policy.body != blank
        assign body_html = shop.shipping_policy.body
      endif
  endcase
-%}

{%- if body_html != blank -%}
  <details class="q-accordion" {% if block.settings.open_by_default %}open{% endif %} {{ block.shopify_attributes }}>
    <summary class="q-accordion__trigger">
      <span class="q-accordion__title">{{ block.settings.heading }}</span>
      <span class="q-accordion__sign" aria-hidden="true"></span>
    </summary>
    <div class="q-accordion__body q-body-sm">
      {{ body_html }}
    </div>
  </details>
{%- endif -%}

{% stylesheet %}
  .q-accordion[open] .q-accordion__sign::after {
    content: "−";
  }
  .q-accordion:not([open]) .q-accordion__sign::after {
    content: "+";
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Product Detail Accordion",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Product"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "OLFACTORY STORY & WEAR"
    },
    {
      "type": "select",
      "id": "source",
      "label": "Content source",
      "options": [
        { "value": "custom", "label": "Custom text" },
        { "value": "story", "label": "Olfactory story & product description" },
        { "value": "inci", "label": "INCI & care metafield" },
        { "value": "shipping", "label": "Product shipping metafield or store policy" }
      ],
      "default": "custom"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Fallback / custom content"
    },
    {
      "type": "checkbox",
      "id": "open_by_default",
      "label": "Open by default",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "Product Detail Accordion",
      "category": "Product",
      "settings": {
        "product": "{{ closest.product }}"
      }
    }
  ]
}
{% endschema %}
