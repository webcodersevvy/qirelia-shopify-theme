{%- liquid
  assign target_product = block.settings.product | default: product
  assign top_notes = target_product.metafields.qirelia.top_notes.value | default: block.settings.top_fallback
  assign heart_notes = target_product.metafields.qirelia.heart_notes.value | default: block.settings.heart_fallback
  assign base_notes = target_product.metafields.qirelia.base_notes.value | default: block.settings.base_fallback
-%}

{%- if top_notes != blank or heart_notes != blank or base_notes != blank -%}
  <div class="q-olfactory-matrix" {{ block.shopify_attributes }}>
    {%- if top_notes != blank -%}
      <div class="q-olfactory-row">
        <span class="q-mono-spec q-olfactory-row__label">{{ 'products.product.olfactory_top' | t }}</span>
        <span class="q-body" style="color: var(--q-dark-01);">{{ top_notes }}</span>
      </div>
    {%- endif -%}
    {%- if heart_notes != blank -%}
      <div class="q-olfactory-row">
        <span class="q-mono-spec q-olfactory-row__label">{{ 'products.product.olfactory_heart' | t }}</span>
        <span class="q-body" style="color: var(--q-dark-01);">{{ heart_notes }}</span>
      </div>
    {%- endif -%}
    {%- if base_notes != blank -%}
      <div class="q-olfactory-row">
        <span class="q-mono-spec q-olfactory-row__label">{{ 'products.product.olfactory_base' | t }}</span>
        <span class="q-body" style="color: var(--q-dark-01);">{{ base_notes }}</span>
      </div>
    {%- endif -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Olfactory Matrix",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Product"
    },
    {
      "type": "text",
      "id": "top_fallback",
      "label": "Top notes override (reads qirelia.top_notes metafield if blank)"
    },
    {
      "type": "text",
      "id": "heart_fallback",
      "label": "Heart notes override (reads qirelia.heart_notes metafield if blank)"
    },
    {
      "type": "text",
      "id": "base_fallback",
      "label": "Base notes override (reads qirelia.base_notes metafield if blank)"
    }
  ],
  "presets": [
    {
      "name": "Olfactory Matrix",
      "category": "Product",
      "settings": {
        "product": "{{ closest.product }}"
      }
    }
  ]
}
{% endschema %}
