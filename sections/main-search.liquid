<section class="color-{{ section.settings.color_scheme }} q-color-scheme q-section" style="padding-top: clamp(36px, 4.4vw, 64px); padding-bottom: clamp(72px, 7.8vw, 112px);">
  <div class="q-container" style="display: flex; flex-direction: column; gap: 40px;">
    <div style="max-width: 720px; display: flex; flex-direction: column; gap: 14px;">
      <p class="q-mono-spec" style="margin: 0;">{{ 'general.search.eyebrow' | t }}</p>
      <h1 class="q-display-xl">{{ 'general.search.title' | t }}</h1>
    </div>

    <qirelia-predictive-search>
      <form action="{{ routes.search_url }}" method="get" role="search" style="display: flex; flex-direction: column; gap: 12px;">
        <div class="q-newsletter__row" style="max-width: 680px;">
          <label for="QireliaSearchInput" class="visually-hidden">{{ 'general.search.placeholder' | t }}</label>
          <input
            id="QireliaSearchInput"
            type="search"
            name="q"
            class="q-input"
            value="{{ search.terms | escape }}"
            placeholder="{{ 'general.search.placeholder' | t }}"
            autocomplete="off"
          >
          <button type="submit" class="q-btn q-btn--primary">
            {{ 'general.search.submit' | t }}
          </button>
        </div>
        <div data-predictive-results></div>
      </form>
    </qirelia-predictive-search>

    {%- if search.performed -%}
      <hr class="q-hairline">

      {%- if search.results_count == 0 -%}
        <p class="q-body-lg" style="margin: 0;">
          {{ 'general.search.no_results' | t: terms: search.terms }}
        </p>
      {%- else -%}
        <p class="q-mono-spec" style="margin: 0; color: var(--q-dark-01);">
          {{ 'general.search.results_with_count' | t: count: search.results_count, terms: search.terms }}
        </p>

        {% paginate search.results by 12 %}
          {%- assign product_results = search.results | where: 'object_type', 'product' -%}
          {%- assign page_results = search.results | where: 'object_type', 'page' -%}
          {%- assign article_results = search.results | where: 'object_type', 'article' -%}

          {%- if product_results.size > 0 -%}
            <div style="display: flex; flex-direction: column; gap: 20px;">
              <h2 class="q-mono-spec" style="margin: 0;">{{ 'general.search.products' | t }}</h2>
              <div class="q-grid-3">
                {%- for item in product_results -%}
                  {% render 'fragrance-card', product: item, card_style: 'shop' %}
                {%- endfor -%}
              </div>
            </div>
          {%- endif -%}

          {%- if page_results.size > 0 or article_results.size > 0 -%}
            <div style="display: flex; flex-direction: column; gap: 16px; border-top: var(--q-hairline); padding-top: 28px;">
              {%- if page_results.size > 0 -%}
                <h2 class="q-mono-spec" style="margin: 0;">{{ 'general.search.pages' | t }}</h2>
                {%- for item in page_results -%}
                  <a href="{{ item.url }}" class="q-h4 q-link-editorial">{{ item.title }}</a>
                {%- endfor -%}
              {%- endif -%}

              {%- if article_results.size > 0 -%}
                <h2 class="q-mono-spec" style="margin: 12px 0 0;">{{ 'general.search.articles' | t }}</h2>
                {%- for item in article_results -%}
                  <a href="{{ item.url }}" class="q-h4 q-link-editorial">{{ item.title }}</a>
                {%- endfor -%}
              {%- endif -%}
            </div>
          {%- endif -%}

          {%- if paginate.pages > 1 -%}
            <nav style="display: flex; align-items: center; justify-content: space-between; padding-top: 32px; border-top: var(--q-hairline);" aria-label="{{ 'general.pagination.label' | t }}">
              <div>
                {%- if paginate.previous -%}
                  <a href="{{ paginate.previous.url }}" class="q-mono-spec q-link-editorial">{{ 'general.pagination.previous' | t }}</a>
                {%- endif -%}
              </div>
              <span class="q-mono-spec">{{ 'general.pagination.page' | t: number: paginate.current_page }}</span>
              <div>
                {%- if paginate.next -%}
                  <a href="{{ paginate.next.url }}" class="q-mono-spec q-link-editorial">{{ 'general.pagination.next' | t }}</a>
                {%- endif -%}
              </div>
            </nav>
          {%- endif -%}
        {% endpaginate %}
      {%- endif -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Search Archive",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ]
}
{% endschema %}
