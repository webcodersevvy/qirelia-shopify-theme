<style>
  #recover { display: none; }
  #recover:target { display: flex; }
  #recover:target ~ #login { display: none; }
</style>

<section class="color-{{ section.settings.color_scheme }} q-color-scheme q-section" style="padding-top: clamp(48px, 6vw, 88px); padding-bottom: clamp(72px, 8vw, 120px);">
  <div class="q-container">
    <div class="q-auth-box">
      <div id="recover" style="flex-direction: column; gap: 20px;">
        <div style="display: flex; flex-direction: column; gap: 8px;">
          <p class="q-mono-spec" style="margin: 0; color: var(--q-neutral-03);">{{ 'customer.login_page.eyebrow' | t }}</p>
          <h1 class="q-h1">{{ 'customer.login_page.recover_title' | t }}</h1>
          <p class="q-body-sm" style="margin: 0;">{{ 'customer.login_page.recover_subtitle' | t }}</p>
        </div>

        {%- form 'recover_customer_password', style: 'display: flex; flex-direction: column; gap: 18px;' -%}
          {%- assign recover_success = form.posted_successfully? -%}
          {%- if form.errors -%}
            <div class="q-status-banner q-status-banner--error" role="alert">
              {{ form.errors | default_errors }}
            </div>
          {%- endif -%}

          <div class="q-field">
            <label for="RecoverEmail" class="q-mono-spec">{{ 'customer.login_page.email' | t }}</label>
            <input
              id="RecoverEmail"
              type="email"
              name="email"
              class="q-input"
              autocomplete="email"
              autocorrect="off"
              autocapitalize="off"
              placeholder="{{ 'customer.login_page.email_placeholder' | t }}"
              required
            >
          </div>

          <button type="submit" class="q-btn q-btn--primary q-btn--full">
            {{ 'customer.login_page.recover_submit' | t }}
          </button>

          <a href="#login" class="q-mono-spec q-link-footer" style="align-self: flex-start;">
            {{ 'customer.login_page.recover_cancel' | t }}
          </a>
        {%- endform -%}
      </div>

      <div id="login" style="display: flex; flex-direction: column; gap: 20px;">
        <div style="display: flex; flex-direction: column; gap: 8px;">
          <p class="q-mono-spec" style="margin: 0; color: var(--q-neutral-03);">{{ 'customer.login_page.eyebrow' | t }}</p>
          <h1 class="q-h1">{{ 'customer.login_page.title' | t }}</h1>
          <p class="q-body-sm" style="margin: 0;">{{ 'customer.login_page.subtitle' | t }}</p>
        </div>

        {%- if recover_success == true -%}
          <div class="q-status-banner q-status-banner--success" role="status">
            {{ 'customer.login_page.recover_success' | t }}
          </div>
        {%- endif -%}

        {%- form 'customer_login', style: 'display: flex; flex-direction: column; gap: 18px;' -%}
          {%- if form.errors -%}
            <div class="q-status-banner q-status-banner--error" role="alert">
              {{ form.errors | default_errors }}
            </div>
          {%- endif -%}

          <div class="q-field">
            <label for="CustomerEmail" class="q-mono-spec">{{ 'customer.login_page.email' | t }}</label>
            <input
              id="CustomerEmail"
              type="email"
              name="customer[email]"
              class="q-input"
              autocomplete="email"
              autocorrect="off"
              autocapitalize="off"
              placeholder="{{ 'customer.login_page.email_placeholder' | t }}"
              required
            >
          </div>

          <div class="q-field">
            <label for="CustomerPassword" class="q-mono-spec">{{ 'customer.login_page.password' | t }}</label>
            <input
              id="CustomerPassword"
              type="password"
              name="customer[password]"
              class="q-input"
              autocomplete="current-password"
              placeholder="{{ 'customer.login_page.password_placeholder' | t }}"
              required
            >
          </div>

          <a href="#recover" class="q-mono-spec q-link-footer" style="align-self: flex-start;">
            {{ 'customer.login_page.forgot_password' | t }}
          </a>

          <button type="submit" class="q-btn q-btn--primary q-btn--full">
            {{ 'customer.login_page.sign_in' | t }}
          </button>
        {%- endform -%}

        <hr class="q-hairline">

        <div style="display: flex; flex-direction: column; align-items: flex-start; gap: 8px;">
          <p class="q-mono-spec" style="margin: 0;">{{ 'customer.login_page.new_to_house' | t }}</p>
          <a href="{{ routes.account_register_url }}" class="q-mono-spec q-link-editorial">
            {{ 'customer.login_page.create_account' | t }}
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Customer Sign In",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ]
}
{% endschema %}
