{%- liquid
  assign primary_menu = section.settings.main_menu
  if primary_menu == blank
    assign primary_menu = linklists['main-menu']
  endif
  assign right_menu = section.settings.utility_menu
  if right_menu == blank
    assign right_menu = linklists['header-utility']
  endif

  assign archive_col = section.settings.archive_collection | default: collections['the-permanent-archive']
  assign reserve_col = section.settings.reserve_collection | default: collections['the-reserve-editions']
  assign contact_page = section.settings.contact_page | default: pages['contact']
  assign guide_page = section.settings.guide_page | default: pages['format-guide'] | default: pages['format-care-guide']

  assign mega_link = blank
  if primary_menu != blank
    for link in primary_menu.links
      if link.links.size > 0
        assign mega_link = link
        break
      endif
    endfor
  endif
-%}

<qirelia-header
  class="q-header"
  data-cart-type="{{ settings.cart_type }}"
>
  <div id="qirelia-drawer-backdrop" class="q-drawer-backdrop" data-backdrop aria-hidden="true"></div>

  <header class="q-header__rail">
    <nav class="q-header__inner" aria-label="Primary navigation">
      <div class="q-header__left">
        <button
          type="button"
          class="q-header__menu-trigger"
          data-menu-trigger
          aria-expanded="false"
          aria-controls="QireliaMobileDrawer"
          aria-label="{{ 'general.accessibility.open_menu' | t }}"
        >
          <span class="q-header__hamburger" aria-hidden="true">
            <span class="q-header__hamburger-line q-header__hamburger-line--top"></span>
            <span class="q-header__hamburger-line q-header__hamburger-line--bottom"></span>
          </span>
          <span class="q-header__menu-label">{{ 'header.menu_label' | t }}</span>
        </button>

        {%- if primary_menu != blank and primary_menu.links.size > 0 -%}
          <ul class="q-header__nav-list">
            {%- for link in primary_menu.links -%}
              {%- if link.links.size > 0 -%}
                <li data-mega-hover-scope>
                  <a
                    href="{{ link.url }}"
                    class="q-link-nav{% if link.active or link.child_active %} is-active{% endif %}"
                    data-mega-trigger
                    aria-expanded="false"
                    aria-controls="QireliaMegaDrawer"
                    {% if link.current %}aria-current="page"{% endif %}
                  >
                    {{ link.title }}
                  </a>
                </li>
              {%- else -%}
                <li>
                  <a
                    href="{{ link.url }}"
                    class="q-link-nav{% if link.active %} is-active{% endif %}"
                    {% if link.current %}aria-current="page"{% endif %}
                  >
                    {{ link.title }}
                  </a>
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>

      <a href="{{ routes.root_url }}" class="q-header__logo-link" aria-label="{{ shop.name }}">
        {%- if section.settings.logo != blank -%}
          {% render 'media-image',
            image: section.settings.logo,
            alt: shop.name,
            sizes: '180px',
            eager: true
          %}
        {%- else -%}
          {%- liquid
            assign logo_tracking = section.settings.logo_letter_spacing | times: 0.01 | append: 'em'
            assign logo_font_stack = 'var(--q-font-display, "Bodoni Moda", Georgia, serif)'
            if section.settings.logo_font_family == 'body'
              assign logo_font_stack = 'var(--q-font-body, "Satoshi", sans-serif)'
            elsif section.settings.logo_font_family == 'mono'
              assign logo_font_stack = 'var(--q-font-mono, monospace)'
            endif
          -%}
          <span
            class="q-header__wordmark"
            style="--q-logo-font: {{ logo_font_stack }}; --q-logo-size: {{ section.settings.logo_font_size }}px; --q-logo-size-mobile: {{ section.settings.logo_font_size_mobile }}px; --q-logo-weight: {{ section.settings.logo_font_weight }}; --q-logo-tracking: {{ logo_tracking }}; --q-logo-transform: {{ section.settings.logo_text_transform }}; --q-logo-color: {{ section.settings.logo_color }};"
          >{{ section.settings.wordmark_text | default: shop.name }}</span>
        {%- endif -%}
      </a>

      <div class="q-header__right">
        <ul class="q-header__utility-list">
          {%- if shop.customer_accounts_enabled -%}
            <li>
              <a
                href="{{ routes.account_url }}"
                class="q-link-nav{% if request.page_type contains 'customers/' %} is-active{% endif %}"
                {% if request.page_type contains 'customers/' %}aria-current="page"{% endif %}
              >
                {{ section.settings.nav_account_label | default: 'Account' }}
              </a>
            </li>
          {%- endif -%}

          {%- if right_menu != blank and right_menu.links.size > 0 -%}
            {%- for util_link in right_menu.links -%}
              <li>
                <a
                  href="{{ util_link.url }}"
                  class="q-link-nav{% if util_link.active %} is-active{% endif %}"
                  {% if util_link.current %}aria-current="page"{% endif %}
                >
                  {{ util_link.title }}
                </a>
              </li>
            {%- endfor -%}
          {%- elsif contact_page != blank -%}
            <li>
              <a
                href="{{ contact_page.url }}"
                class="q-link-nav{% if page.handle == contact_page.handle %} is-active{% endif %}"
                {% if page.handle == contact_page.handle %}aria-current="page"{% endif %}
              >
                {{ contact_page.title }}
              </a>
            </li>
          {%- endif -%}
        </ul>

        <a
          href="{{ routes.cart_url }}"
          class="q-header__bag-trigger q-link-nav"
          data-bag-trigger
          aria-expanded="false"
          aria-controls="QireliaBagDrawer"
          aria-label="{{ 'general.accessibility.open_bag' | t }}"
        >
          <span>{{ 'header.bag_label' | t }}</span>
          <span data-bag-count>({{ cart.item_count }})</span>
        </a>
      </div>
    </nav>
  </header>

  {%- if mega_link != blank and mega_link.links.size > 0 -%}
    <!-- Fragrances Mega Drawer (driven by Shopify Navigation Menu & Collection Objects) -->
    <div
      id="QireliaMegaDrawer"
      class="q-drawer q-section--rail"
      data-drawer="mega"
      role="region"
      aria-label="{{ 'header.mega.eyebrow' | t }}"
    >
      <div class="q-container--rail">
        <div class="q-mega__back-bar">
          <button type="button" class="q-mega__back-btn" data-back-to-menu>
            {{ 'header.back_to_menu' | t }}
          </button>
          <span class="q-mono-spec">{{ 'header.tap_hint' | t }}</span>
        </div>

        <div class="q-mega__inner">
          <div>
            <div class="q-mega__eyebrow">
              <span class="q-mono-spec">{{ 'header.mega.eyebrow' | t }}</span>
              <a href="{{ routes.collections_url }}" class="q-mono-spec q-link-editorial">
                {{ 'header.mega.view_all' | t }}
              </a>
            </div>

            {%- for child_link in mega_link.links -%}
              {%- liquid
                assign row_index = forloop.index | prepend: '0' | slice: -2, 2
                assign row_key = child_link.handle | default: forloop.index
                assign col_obj = blank
                if child_link.type == 'collection_link'
                  assign col_obj = child_link.object
                elsif child_link.url == routes.all_products_collection_url
                  assign col_obj = collections['all']
                endif

                assign row_spec = ''
                if col_obj != blank
                  assign row_spec = col_obj.metafields.qirelia.mega_spec.value
                  if row_spec == blank
                    assign count_padded = col_obj.products_count | prepend: '0' | slice: -2, 2
                    assign row_spec = 'collections.general.compositions_count' | t: count: count_padded
                  endif
                endif
              -%}
              <a
                href="{{ child_link.url }}"
                class="q-mega__row{% if forloop.first %} is-active{% endif %}"
                data-mega-row="{{ row_key }}"
              >
                <div class="q-mega__row-left">
                  <span class="q-mega__index-group">
                    <span class="q-mega__amber-bar" aria-hidden="true"></span>
                    <span class="q-mega__index">{{ row_index }}</span>
                  </span>
                  <div>
                    <div class="q-mega__title">{{ child_link.title }}</div>
                    {%- if row_spec != blank -%}
                      <div class="q-mono-spec q-mega__specs">{{ row_spec }}</div>
                    {%- endif -%}
                  </div>
                </div>
                <span class="q-mega__arrow" aria-hidden="true">→</span>
              </a>
            {%- endfor -%}

            <div class="q-mega__footnote">
              <span class="q-mono-spec">{{ 'header.mega.footnote' | t }}</span>
              {%- if guide_page != blank -%}
                <a href="{{ guide_page.url }}" class="q-mono-spec q-link-editorial">
                  {{ 'header.mega.format_guide' | t }}
                </a>
              {%- endif -%}
            </div>
          </div>

          <div class="q-mega__preview">
            <div class="q-mega__stage">
              {%- for child_link in mega_link.links -%}
                {%- liquid
                  assign row_key = child_link.handle | default: forloop.index
                  assign col_obj = blank
                  if child_link.type == 'collection_link'
                    assign col_obj = child_link.object
                  elsif child_link.url == routes.all_products_collection_url
                    assign col_obj = collections['all']
                  endif
                  assign stage_img = col_obj.featured_image | default: col_obj.products.first.featured_image
                -%}
                <a
                  href="{{ child_link.url }}"
                  class="q-mega__cover{% if forloop.first %} is-active{% endif %}"
                  data-mega-cover="{{ row_key }}"
                >
                  {% render 'media-image',
                    image: stage_img,
                    alt: child_link.title,
                    width: 1200,
                    height: 900,
                    sizes: '540px'
                  %}
                </a>
              {%- endfor -%}
            </div>

            {%- for child_link in mega_link.links -%}
              {%- liquid
                assign row_key = child_link.handle | default: forloop.index
                assign col_obj = blank
                if child_link.type == 'collection_link'
                  assign col_obj = child_link.object
                elsif child_link.url == routes.all_products_collection_url
                  assign col_obj = collections['all']
                endif

                assign caption_text = child_link.title | upcase
                if col_obj != blank and col_obj.products_count > 0
                  if col_obj.handle == 'all'
                    assign all_padded = col_obj.all_products_count | default: col_obj.products_count | prepend: '0' | slice: -2, 2
                    assign caption_text = 'collections.general.compositions_count' | t: count: all_padded
                  else
                    assign caption_text = col_obj.products | map: 'title' | slice: 0, 4 | join: ' · '
                  endif
                endif
              -%}
              <div
                class="q-mega__caption-row{% if forloop.first %} is-active{% endif %}"
                data-mega-caption="{{ row_key }}"
              >
                <span class="q-mono-spec" style="color: var(--q-dark-03);">{{ caption_text }}</span>
                <a href="{{ child_link.url }}" class="q-ui-label q-link-editorial">{{ 'header.mega.explore_collection' | t }}</a>
              </div>
            {%- endfor -%}
          </div>
        </div>
      </div>
    </div>
  {%- endif -%}

  <!-- Minimalist Bag Drawer -->
  <div
    id="QireliaBagDrawer"
    class="q-drawer q-section--rail"
    data-drawer="bag"
    role="dialog"
    aria-modal="true"
    aria-label="{{ 'cart.page.title' | t }}"
  >
    <div data-cart-drawer-mount>
      {% render 'cart-drawer-body',
        curated_collection_primary: archive_col,
        curated_collection_secondary: reserve_col,
        guide_page: guide_page
      %}
    </div>
  </div>

  <!-- Editorial Mobile / Tablet Drawer -->
  <div
    id="QireliaMobileDrawer"
    class="q-drawer q-section--rail"
    data-drawer="mobile"
    role="region"
    aria-label="{{ 'general.accessibility.open_menu' | t }}"
  >
    <div class="q-container--rail q-mobile-drawer__inner">
      {%- if primary_menu != blank and primary_menu.links.size > 0 -%}
        <div class="q-mobile-drawer__links">
          {%- for link in primary_menu.links -%}
            {%- if link.links.size > 0 -%}
              <button type="button" class="q-mobile-drawer__row" data-open-mobile-mega>
                <span class="q-mobile-drawer__title">{{ link.title }}</span>
                <span class="q-mono-spec">{{ link.links.size | prepend: '0' | slice: -2, 2 }} COLLECTIONS →</span>
              </button>
            {%- else -%}
              <a href="{{ link.url }}" class="q-mobile-drawer__row">
                <span class="q-mobile-drawer__title">{{ link.title }}</span>
                <span class="q-mono-spec">→</span>
              </a>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}

      <div class="q-mobile-drawer__utility">
        {%- if shop.customer_accounts_enabled -%}
          <a href="{{ routes.account_url }}" class="q-ui-label q-link-nav">
            {{ section.settings.nav_account_label | default: 'Account' }}
          </a>
        {%- endif -%}
        <a href="{{ routes.search_url }}" class="q-ui-label q-link-nav">{{ 'general.search.submit' | t }}</a>
        {%- if right_menu != blank and right_menu.links.size > 0 -%}
          {%- for util_link in right_menu.links -%}
            <a href="{{ util_link.url }}" class="q-ui-label q-link-nav">{{ util_link.title }}</a>
          {%- endfor -%}
        {%- endif -%}
        {%- if guide_page != blank -%}
          <a href="{{ guide_page.url }}" class="q-ui-label q-link-nav">{{ guide_page.title }}</a>
        {%- endif -%}
      </div>
    </div>
  </div>
</qirelia-header>

{% schema %}
{
  "name": "QIRÉLIA Header",
  "class": "q-header-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Custom wordmark image (optional)"
    },
    {
      "type": "text",
      "id": "wordmark_text",
      "label": "Wordmark text fallback"
    },
    {
      "type": "header",
      "content": "Brand Logo Text Styles"
    },
    {
      "type": "select",
      "id": "logo_font_family",
      "label": "Font family",
      "options": [
        { "value": "display", "label": "Display Serif" },
        { "value": "body", "label": "Body Sans" },
        { "value": "mono", "label": "Monospace" }
      ],
      "default": "display"
    },
    {
      "type": "range",
      "id": "logo_font_size",
      "label": "Desktop font size",
      "min": 16,
      "max": 56,
      "step": 1,
      "unit": "px",
      "default": 29
    },
    {
      "type": "range",
      "id": "logo_font_size_mobile",
      "label": "Mobile font size",
      "min": 14,
      "max": 36,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "select",
      "id": "logo_font_weight",
      "label": "Font weight",
      "options": [
        { "value": "300", "label": "Light (300)" },
        { "value": "400", "label": "Regular (400)" },
        { "value": "500", "label": "Medium (500)" },
        { "value": "600", "label": "Semi-bold (600)" },
        { "value": "700", "label": "Bold (700)" }
      ],
      "default": "400"
    },
    {
      "type": "range",
      "id": "logo_letter_spacing",
      "label": "Letter spacing (x0.01 em)",
      "min": 0,
      "max": 50,
      "step": 2,
      "default": 32,
      "info": "32 equals 0.32em architectural tracking."
    },
    {
      "type": "select",
      "id": "logo_text_transform",
      "label": "Text case",
      "options": [
        { "value": "uppercase", "label": "Uppercase" },
        { "value": "none", "label": "As typed" },
        { "value": "capitalize", "label": "Capitalize" },
        { "value": "lowercase", "label": "Lowercase" }
      ],
      "default": "uppercase"
    },
    {
      "type": "color",
      "id": "logo_color",
      "label": "Text color",
      "default": "#141414"
    },
    {
      "type": "header",
      "content": "Navigation Menus"
    },
    {
      "type": "link_list",
      "id": "main_menu",
      "label": "Primary navigation menu",
      "default": "main-menu"
    },
    {
      "type": "link_list",
      "id": "utility_menu",
      "label": "Right utility menu"
    },
    {
      "type": "text",
      "id": "nav_account_label",
      "label": "Account link label",
      "default": "Account"
    },
    {
      "type": "header",
      "content": "Bag drawer & linked references"
    },
    {
      "type": "collection",
      "id": "archive_collection",
      "label": "Curated primary collection"
    },
    {
      "type": "collection",
      "id": "reserve_collection",
      "label": "Curated secondary collection"
    },
    {
      "type": "page",
      "id": "contact_page",
      "label": "Contact fallback page"
    },
    {
      "type": "page",
      "id": "guide_page",
      "label": "Format & Care Guide page"
    }
  ]
}
{% endschema %}
