{%- liquid
  assign disclaimer_page = section.settings.related_page | default: pages['disclaimer']
-%}
<section class="color-{{ section.settings.color_scheme }} q-color-scheme q-section" style="padding-bottom: clamp(72px, 7.8vw, 112px);">
  <div class="q-container">
    <div class="q-legal-split">
      <aside class="q-legal-index" aria-label="{{ section.settings.index_heading }}">
        <p class="q-mono-spec" style="margin: 0; color: var(--q-dark-01);">
          {{ section.settings.index_heading | default: 'DOCUMENT INDEX' }}
        </p>
        <hr class="q-hairline">
        {%- for block in section.blocks -%}
          <a href="#clause-{{ block.id }}" class="q-mono-spec q-link-footer">
            {{ block.settings.index_label | default: block.settings.heading }}
          </a>
        {%- endfor -%}
        {%- if section.settings.related_label != blank -%}
          <hr class="q-hairline">
          <a href="{{ disclaimer_page.url | default: routes.root_url }}" class="q-mono-spec q-link-editorial">
            {{ section.settings.related_label }}
          </a>
        {%- endif -%}
      </aside>

      <div class="q-legal-clauses">
        {%- for block in section.blocks -%}
          <article id="clause-{{ block.id }}" style="display: flex; flex-direction: column; gap: 10px;" {{ block.shopify_attributes }}>
            <h2 class="q-mono-spec" style="margin: 0; color: var(--q-dark-01);">{{ block.settings.heading }}</h2>
            <div class="q-body">{{ block.settings.body }}</div>
          </article>
          {%- unless forloop.last -%}
            <hr class="q-hairline">
          {%- endunless -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Legal Document Split",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "index_heading",
      "label": "Index sidebar heading",
      "default": "DOCUMENT INDEX"
    },
    {
      "type": "text",
      "id": "related_label",
      "label": "Sidebar footer link label",
      "default": "READ FRAGRANCE DISCLAIMER →"
    },
    {
      "type": "page",
      "id": "related_page",
      "label": "Related legal page"
    }
  ],
  "blocks": [
    {
      "type": "clause",
      "name": "Legal Clause",
      "settings": [
        {
          "type": "text",
          "id": "index_label",
          "label": "Index label",
          "default": "01 · House Identity & Scope"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Clause heading",
          "default": "01 / HOUSE IDENTITY & SCOPE"
        },
        {
          "type": "richtext",
          "id": "body",
          "label": "Clause copy",
          "default": "<p>By accessing or placing an order through the QIRÉLIA online flagship, you agree to be bound by these Terms & Conditions and all referenced policies.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Legal Document Split",
      "category": "Editorial"
    }
  ]
}
{% endschema %}
