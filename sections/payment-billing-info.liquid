<section class="color-{{ section.settings.color_scheme }} q-color-scheme q-section" style="padding-top: clamp(36px, 4.4vw, 64px); padding-bottom: clamp(72px, 7.8vw, 112px);">
  <div class="q-container" style="display: flex; flex-direction: column; gap: 36px;">
    <nav class="q-stepper" aria-label="{{ section.settings.heading }}">
      <a href="{{ routes.cart_url }}" class="q-mono-spec q-link-footer">{{ 'cart.stepper.bag' | t }}</a>
      <span class="q-mono-spec" aria-hidden="true">—</span>
      <span class="q-mono-spec" style="color: var(--q-dark-05);">{{ 'cart.stepper.checkout' | t }}</span>
      <span class="q-mono-spec" aria-hidden="true">—</span>
      <span class="q-mono-spec" style="color: var(--q-dark-01);" aria-current="step">{{ 'cart.stepper.payment' | t }}</span>
    </nav>

    <div style="display: flex; flex-direction: column; gap: 10px;">
      {%- if section.settings.eyebrow != blank -%}
        <p class="q-mono-spec" style="margin: 0; color: var(--q-neutral-03);">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h1 class="q-display-xl">{{ section.settings.heading | default: page.title }}</h1>
      {%- if section.settings.subtext != blank -%}
        <p class="q-body-lg" style="margin: 0; max-width: 720px;">{{ section.settings.subtext }}</p>
      {%- endif -%}
    </div>

    <div class="q-split-main">
      <div class="q-split-main__left" style="display: flex; flex-direction: column; gap: 24px;">
        <div class="q-form-panel">
          <div style="display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap;">
            <p class="q-mono-spec" style="margin: 0; color: var(--q-dark-01);">{{ section.settings.card_eyebrow }}</p>
            <p class="q-mono-spec" style="margin: 0;">{{ section.settings.accepted_methods_label }}</p>
          </div>

          <hr class="q-hairline">

          <h2 class="q-h3">{{ section.settings.checkout_heading }}</h2>
          <p class="q-body" style="margin: 0;">{{ section.settings.checkout_copy }}</p>

          {%- if shop.enabled_payment_types.size > 0 -%}
            <div style="display: flex; align-items: center; flex-wrap: wrap; gap: 10px;" aria-label="{{ section.settings.accepted_methods_label }}">
              {%- for type in shop.enabled_payment_types -%}
                <span class="q-status-pill" style="padding: 6px 10px;">{{ type | replace: '_', ' ' }}</span>
              {%- endfor -%}
            </div>
          {%- endif -%}

          <div style="display: flex; flex-wrap: wrap; gap: 12px; padding-top: 8px;">
            {%- if cart.item_count > 0 -%}
              <form action="{{ routes.cart_url }}" method="post">
                <button type="submit" name="checkout" class="q-btn q-btn--primary">
                  {{ 'cart.page.checkout' | t }} · {{ cart.total_price | money_without_trailing_zeros }}
                  {% if settings.show_currency_code %} {{ cart.currency.iso_code }}{% endif %}
                </button>
              </form>
              <a href="{{ routes.cart_url }}" class="q-btn q-btn--secondary">
                {{ 'cart.drawer.open_full_bag' | t }}
              </a>
            {%- else -%}
              <a href="{{ routes.collections_url }}" class="q-btn q-btn--primary">
                {{ 'cart.drawer.empty_cta' | t }}
              </a>
              <a href="{{ routes.account_url }}" class="q-btn q-btn--secondary">
                {{ 'customer.account.title' | t }}
              </a>
            {%- endif -%}
          </div>
        </div>

        <a href="{{ routes.account_url }}" class="q-mono-spec q-link-editorial" style="align-self: flex-start;">
          {{ section.settings.account_back_label }}
        </a>
      </div>

      <aside class="q-split-main__right" aria-label="{{ section.settings.terms_eyebrow }}">
        <p class="q-mono-spec" style="margin: 0; color: var(--q-dark-01);">{{ section.settings.terms_eyebrow }}</p>
        <hr class="q-hairline">

        <div style="display: flex; flex-direction: column; gap: 20px;">
          {%- for block in section.blocks -%}
            <div style="display: flex; flex-direction: column; gap: 6px;" {{ block.shopify_attributes }}>
              <p class="q-mono-spec" style="margin: 0; color: var(--q-dark-01);">{{ block.settings.title }}</p>
              <p class="q-body-sm" style="margin: 0;">{{ block.settings.body }}</p>
            </div>
            {%- unless forloop.last -%}
              <hr class="q-hairline">
            {%- endunless -%}
          {%- endfor -%}
        </div>
      </aside>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Payment & Billing",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "EXPRESS SETTLEMENT  ·  SHOPIFY CHECKOUT"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "PAYMENT & BILLING"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Lead summary",
      "default": "Complete your QIRÉLIA order via encrypted Shopify Checkout—cards, Apple Pay, Shop Pay, and transparent billing terms."
    },
    {
      "type": "text",
      "id": "card_eyebrow",
      "label": "Checkout panel label",
      "default": "SHOPIFY ENCRYPTED SETTLEMENT"
    },
    {
      "type": "text",
      "id": "accepted_methods_label",
      "label": "Accepted methods caption",
      "default": "VISA  ·  MASTERCARD  ·  AMEX  ·  SHOP PAY  ·  APPLE PAY"
    },
    {
      "type": "text",
      "id": "checkout_heading",
      "label": "Checkout panel heading",
      "default": "ENCRYPTED CHECKOUT REDIRECT"
    },
    {
      "type": "textarea",
      "id": "checkout_copy",
      "label": "Checkout panel description",
      "default": "For client security and PCI-DSS Level 1 compliance, QIRÉLIA never collects raw card credentials on storefront theme pages. Selecting Proceed to Checkout transfers your shopping bag directly into Shopify’s encrypted payment environment."
    },
    {
      "type": "text",
      "id": "terms_eyebrow",
      "label": "Billing terms panel heading",
      "default": "SECURITY & BILLING TERMS"
    },
    {
      "type": "text",
      "id": "account_back_label",
      "label": "Back link label",
      "default": "RETURN TO ACCOUNT OVERVIEW →"
    }
  ],
  "blocks": [
    {
      "type": "billing_term",
      "name": "Billing Term",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Heading",
          "default": "PCI-DSS LEVEL 1 ENCRYPTION"
        },
        {
          "type": "textarea",
          "id": "body",
          "label": "Copy",
          "default": "All payment credentials are processed exclusively via Shopify’s encrypted checkout infrastructure. QIRÉLIA never stores raw card numbers on its servers."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Payment & Billing",
      "category": "Editorial"
    }
  ]
}
{% endschema %}
