<section class="color-{{ section.settings.color_scheme }} q-color-scheme q-section" style="padding-top: clamp(48px, 6vw, 88px); padding-bottom: clamp(72px, 8vw, 120px);">
  <div class="q-container">
    <div class="q-auth-box">
      <div style="display: flex; flex-direction: column; gap: 8px;">
        <p class="q-mono-spec" style="margin: 0; color: var(--q-neutral-03);">{{ 'customer.reset_password.eyebrow' | t }}</p>
        <h1 class="q-h1">{{ 'customer.reset_password.title' | t }}</h1>
        <p class="q-body-sm" style="margin: 0;">{{ 'customer.reset_password.subtext' | t }}</p>
      </div>

      {%- form 'reset_customer_password', style: 'display: flex; flex-direction: column; gap: 18px;' -%}
        {%- if form.errors -%}
          <div class="q-status-banner q-status-banner--error" role="alert">
            {{ form.errors | default_errors }}
          </div>
        {%- endif -%}

        <div class="q-field">
          <label for="ResetPassword" class="q-mono-spec">{{ 'customer.reset_password.password' | t }}</label>
          <input
            id="ResetPassword"
            type="password"
            name="customer[password]"
            class="q-input"
            autocomplete="new-password"
            required
          >
        </div>

        <div class="q-field">
          <label for="ResetPasswordConfirm" class="q-mono-spec">{{ 'customer.reset_password.password_confirm' | t }}</label>
          <input
            id="ResetPasswordConfirm"
            type="password"
            name="customer[password_confirmation]"
            class="q-input"
            autocomplete="new-password"
            required
          >
        </div>

        <button type="submit" class="q-btn q-btn--primary q-btn--full">
          {{ 'customer.reset_password.submit' | t }}
        </button>
      {%- endform -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Reset Customer Password",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ]
}
{% endschema %}
