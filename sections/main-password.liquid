<section class="color-{{ section.settings.color_scheme }} q-color-scheme q-section" style="min-height: 100vh; display: flex; align-items: center; padding-block: clamp(48px, 6vw, 80px);">
  <div class="q-container" style="display: flex; flex-direction: column; align-items: center; gap: 36px;">
    <div style="text-align: center; display: flex; flex-direction: column; align-items: center; gap: 10px;">
      <p class="q-header__wordmark" style="margin: 0;">{{ shop.name }}</p>
      {%- if settings.tagline != blank -%}
        <p class="q-mono-spec" style="margin: 0; color: var(--q-neutral-03);">{{ settings.tagline }}</p>
      {%- endif -%}
    </div>

    <div class="q-auth-box">
      <div style="display: flex; flex-direction: column; gap: 10px;">
        <p class="q-mono-spec" style="margin: 0; color: var(--q-dark-01);">{{ 'general.password_page.login_form_heading' | t }}</p>
        {%- if shop.password_message != blank -%}
          <p class="q-body" style="margin: 0;">{{ shop.password_message }}</p>
        {%- endif -%}
      </div>

      {%- form 'storefront_password', style: 'display: flex; flex-direction: column; gap: 18px;' -%}
        {%- if form.errors -%}
          <div class="q-status-banner q-status-banner--error" role="alert">
            {{ form.errors | default_errors }}
          </div>
        {%- endif -%}

        <div class="q-field">
          <label for="PasswordInput" class="q-mono-spec">{{ 'general.password_page.login_form_password_label' | t }}</label>
          <input
            id="PasswordInput"
            type="password"
            name="password"
            class="q-input"
            autocomplete="current-password"
            placeholder="{{ 'general.password_page.login_form_password_placeholder' | t }}"
            required
          >
        </div>

        <button type="submit" class="q-btn q-btn--primary q-btn--full">
          {{ 'general.password_page.login_form_submit' | t }}
        </button>
      {%- endform -%}

      <hr class="q-hairline">
      <div style="display: flex; flex-direction: column; gap: 6px; text-align: center;">
        <p class="q-body-sm" style="margin: 0;">{{ 'general.password_page.admin_link_html' | t }}</p>
        {%- capture shopify_link -%}
          <a href="//www.shopify.com" rel="noopener" target="_blank" class="q-link-footer">Shopify</a>
        {%- endcapture -%}
        <p class="q-mono-spec" style="margin: 0;">{{ 'general.password_page.powered_by_shopify_html' | t: shopify: shopify_link }}</p>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Password Gate",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ]
}
{% endschema %}
