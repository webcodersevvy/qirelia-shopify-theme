{%- liquid
  assign heading_text = section.settings.heading | default: page.title
  assign pad_bottom = '48px'
  if section.settings.show_hero_image
    assign pad_bottom = '80px'
  endif
-%}

<section
  class="color-{{ section.settings.color_scheme }} q-color-scheme q-section"
  style="padding-top: clamp(36px, 4.4vw, 64px); padding-bottom: {{ pad_bottom }};"
>
  <div class="q-container" style="display: flex; flex-direction: column; gap: 32px;">
    {%- if section.settings.show_hero_image -%}
      <div class="q-collection-hero__media" style="height: clamp(320px, 36vw, 520px);">
        {%- assign hero_alt = section.settings.image.alt | default: heading_text -%}
        {% render 'media-image',
          image: section.settings.image,
          fallback_asset: 'qirelia-house-hero.jpg',
          alt: hero_alt,
          width: 1200,
          height: 1800,
          sizes: '100vw',
          eager: true
        %}
      </div>
    {%- endif -%}

    <div style="max-width: 780px; display: flex; flex-direction: column; gap: 12px;">
      {%- if section.settings.eyebrow != blank -%}
        <p class="q-mono-spec" style="margin: 0;">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h1 class="q-display-xl">{{ heading_text }}</h1>
      {%- if section.settings.subtext != blank -%}
        <p class="q-body-lg" style="margin: 0;">{{ section.settings.subtext }}</p>
      {%- endif -%}
    </div>

    {%- if section.settings.show_bottom_divider -%}
      <hr class="q-hairline" style="margin-top: 12px;">
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Editorial Page Header",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "show_hero_image",
      "label": "Show architectural hero image above title",
      "default": false
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero image",
      "visible_if": "{{ section.settings.show_hero_image }}"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "THE HOUSE OF QIRÉLIA"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading override (uses page title if blank)"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Lead summary"
    },
    {
      "type": "checkbox",
      "id": "show_bottom_divider",
      "label": "Show bottom hairline divider",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "Editorial Page Header",
      "category": "Editorial"
    }
  ]
}
{% endschema %}
