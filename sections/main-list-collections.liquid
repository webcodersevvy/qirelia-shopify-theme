{%- liquid
  assign archive_col = section.settings.archive_collection | default: collections['the-permanent-archive']
  assign reserve_col = section.settings.reserve_collection | default: collections['the-reserve-editions']
  assign rendered_handles = '|'
-%}

<section class="color-{{ section.settings.color_scheme }} q-color-scheme">
  <div class="q-page-intro">
    <div class="q-container" style="display: flex; flex-direction: column; gap: 16px;">
      {%- if section.settings.eyebrow != blank -%}
        <p class="q-mono-spec" style="margin: 0;">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h1 class="q-display-xl">{{ section.settings.heading }}</h1>
      {%- if section.settings.subtext != blank -%}
        <p class="q-body-lg" style="margin: 0; max-width: 620px;">{{ section.settings.subtext }}</p>
      {%- endif -%}
    </div>
  </div>

  {%- assign featured_pair = '' -%}
  {%- if archive_col != blank -%}
    {%- assign featured_pair = archive_col.handle -%}
  {%- endif -%}
  {%- if reserve_col != blank and reserve_col.handle != archive_col.handle -%}
    {%- assign featured_pair = featured_pair | append: ',' | append: reserve_col.handle -%}
  {%- endif -%}

  {%- assign handle_list = featured_pair | split: ',' -%}
  {%- for target_handle in handle_list -%}
    {%- if target_handle != blank -%}
      {%- assign col = collections[target_handle] -%}
      {%- if col != blank -%}
        {%- liquid
          assign rendered_handles = rendered_handles | append: col.handle | append: '|'
          assign col_img = col.featured_image | default: col.products.first.featured_image
          assign col_eyebrow = col.metafields.qirelia.eyebrow_label.value
          assign count_padded = col.products_count | prepend: '0' | slice: -2, 2
          assign sorted_prods = col.products | sort: 'price_min'
          assign min_price = sorted_prods.first.price_min
          assign max_price = sorted_prods.last.price_max
          assign is_reserve_style = false
          if col.handle contains 'reserve'
            assign is_reserve_style = true
          endif
        -%}
        <div class="q-campaign-band">
          <div class="q-container">
            <a href="{{ col.url }}" class="q-campaign__image">
              {%- assign col_alt = col.featured_image.alt | default: col.title -%}
              {% render 'media-image',
                image: col_img,
                alt: col_alt,
                width: 1200,
                height: 900,
                sizes: '100vw',
                eager: forloop.first
              %}
            </a>

            <div class="q-campaign__details">
              <div class="q-campaign__copy">
                {%- if col_eyebrow != blank -%}
                  <p
                    class="q-mono-spec"
                    style="margin: 0;{% if is_reserve_style %} color: var(--q-neutral-03);{% endif %}"
                  >
                    {{ col_eyebrow }}
                  </p>
                {%- endif -%}
                <h2 class="q-h1">{{ col.title | upcase }}</h2>
                {%- if col.description != blank -%}
                  <div class="q-body">{{ col.description }}</div>
                {%- endif -%}
              </div>

              <div class="q-campaign__action">
                <span class="q-mono-spec" style="color: var(--q-dark-01);">
                  {{ 'collections.general.compositions_count' | t: count: count_padded }}
                  {%- if col.products_count > 0 and min_price != blank -%}
                    &nbsp;·&nbsp;{{ min_price | money_without_trailing_zeros }}
                    {%- if max_price > min_price %} – {{ max_price | money_without_trailing_zeros }}{% endif -%}
                    {%- if settings.show_currency_code %} {{ cart.currency.iso_code }}{% endif -%}
                  {%- endif -%}
                </span>
                <a href="{{ col.url }}" class="q-btn q-btn--primary">
                  EXPLORE {{ col.title | upcase }}
                </a>
              </div>
            </div>
          </div>
        </div>
      {%- endif -%}
    {%- endif -%}
  {%- endfor -%}

  {%- if section.settings.show_additional_collections -%}
    {%- for col in collections -%}
      {%- assign token = '|' | append: col.handle | append: '|' -%}
      {%- unless col.handle == 'all' or rendered_handles contains token -%}
        {%- liquid
          assign col_img = col.featured_image | default: col.products.first.featured_image
          assign col_eyebrow = col.metafields.qirelia.eyebrow_label.value
          assign count_padded = col.products_count | prepend: '0' | slice: -2, 2
          assign sorted_prods = col.products | sort: 'price_min'
          assign min_price = sorted_prods.first.price_min
          assign max_price = sorted_prods.last.price_max
        -%}
        <div class="q-campaign-band">
          <div class="q-container">
            <a href="{{ col.url }}" class="q-campaign__image">
              {%- assign col_alt = col.featured_image.alt | default: col.title -%}
              {% render 'media-image',
                image: col_img,
                alt: col_alt,
                width: 1200,
                height: 900,
                sizes: '100vw'
              %}
            </a>
            <div class="q-campaign__details">
              <div class="q-campaign__copy">
                {%- if col_eyebrow != blank -%}
                  <p class="q-mono-spec" style="margin: 0;">{{ col_eyebrow }}</p>
                {%- endif -%}
                <h2 class="q-h1">{{ col.title | upcase }}</h2>
                {%- if col.description != blank -%}
                  <div class="q-body">{{ col.description }}</div>
                {%- endif -%}
              </div>
              <div class="q-campaign__action">
                <span class="q-mono-spec" style="color: var(--q-dark-01);">
                  {{ 'collections.general.compositions_count' | t: count: count_padded }}
                  {%- if col.products_count > 0 and min_price != blank -%}
                    &nbsp;·&nbsp;{{ min_price | money_without_trailing_zeros }}
                    {%- if max_price > min_price %} – {{ max_price | money_without_trailing_zeros }}{% endif -%}
                    {%- if settings.show_currency_code %} {{ cart.currency.iso_code }}{% endif -%}
                  {%- endif -%}
                </span>
                <a href="{{ col.url }}" class="q-btn q-btn--primary">EXPLORE {{ col.title | upcase }}</a>
              </div>
            </div>
          </div>
        </div>
      {%- endunless -%}
    {%- endfor -%}
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Collections Overview",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Intro eyebrow",
      "default": "THE QIRÉLIA ARCHIVE"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Intro heading",
      "default": "TWO EXPRESSIONS OF PRESENCE."
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Intro description",
      "default": "Four foundational 20% Eau de Parfum signatures for daily proximity, paired with two limited-batch 30% Extrait Reserve releases devoted to resin, root, and stillness."
    },
    {
      "type": "collection",
      "id": "archive_collection",
      "label": "Featured collection 1"
    },
    {
      "type": "collection",
      "id": "reserve_collection",
      "label": "Featured collection 2"
    },
    {
      "type": "checkbox",
      "id": "show_additional_collections",
      "label": "Show other store collections below",
      "default": true
    }
  ]
}
{% endschema %}
