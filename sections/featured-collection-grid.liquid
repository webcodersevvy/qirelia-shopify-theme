{%- liquid
  assign target_col = section.settings.collection
  assign heading_url = target_col.url | default: routes.collections_url
  assign heading_text = section.settings.title
  if heading_text == blank and target_col != blank
    assign prefix_num = target_col.metafields.qirelia.index_number.value
    if prefix_num != blank
      assign heading_text = prefix_num | append: ' / ' | append: target_col.title | upcase
    else
      assign heading_text = target_col.title | upcase
    endif
  endif

  assign dynamic_spec = section.settings.meta
  if target_col != blank
    assign count_padded = target_col.products_count | prepend: '0' | slice: -2, 2
    assign col_spec_suffix = target_col.metafields.qirelia.short_spec.value
    if col_spec_suffix != blank
      assign dynamic_spec = count_padded | append: ' COMPOSITIONS  ·  ' | append: col_spec_suffix
    elsif dynamic_spec == blank
      assign dynamic_spec = 'collections.general.compositions_count' | t: count: count_padded
    endif
  endif

  assign band_class = 'q-collection-band'
  if section.settings.is_reserve_band
    assign band_class = band_class | append: ' q-collection-band--reserve'
  endif
  if section.settings.show_top_divider
    assign band_class = band_class | append: ' q-section--divided'
  endif
-%}

<section class="color-{{ section.settings.color_scheme }} q-color-scheme {{ band_class }}">
  <div class="q-container">
    <div class="q-band-head">
      <a href="{{ heading_url }}" class="q-mono-spec q-link-editorial" style="color: var(--q-dark-01);">
        {{ heading_text }}
      </a>
      {%- if dynamic_spec != blank -%}
        <span
          class="q-mono-spec"
          style="{% if section.settings.is_reserve_band %}color: var(--q-neutral-03);{% endif %}"
        >
          {{ dynamic_spec }}
        </span>
      {%- endif -%}
    </div>

    {%- if target_col != blank and target_col.products_count > 0 -%}
      <div class="q-grid-2">
        {%- for prod in target_col.products limit: section.settings.products_to_show -%}
          {% render 'fragrance-card',
            product: prod,
            card_style: 'home',
            show_reserve_badge: section.settings.show_reserve_badge
          %}
        {%- endfor -%}
      </div>
    {%- else -%}
      <div style="height: 120px; border: var(--q-hairline); display: flex; align-items: center; justify-content: center;">
        <p class="q-mono-spec" style="margin: 0;">{{ 'collections.general.empty' | t }}</p>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Fragrance Grid Band",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Left heading override (uses collection title if blank)"
    },
    {
      "type": "text",
      "id": "meta",
      "label": "Right spec label fallback (uses live count & collection metafield)"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Maximum compositions",
      "min": 2,
      "max": 8,
      "step": 2,
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "show_reserve_badge",
      "label": "Show Reserve Edition stamp badge",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "is_reserve_band",
      "label": "Use Reserve band spacing & smoked umber spec color",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_top_divider",
      "label": "Show 1px top hairline divider",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "Fragrance Grid Band",
      "category": "Collection"
    }
  ]
}
{% endschema %}
