{%- liquid
  assign menu_1 = section.settings.col_1_menu
  if menu_1 == blank
    assign menu_1 = linklists['footer-collections']
  endif
  assign menu_2 = section.settings.col_2_menu
  if menu_2 == blank
    assign menu_2 = linklists['footer-client-care']
  endif
  assign menu_3 = section.settings.col_3_menu
  if menu_3 == blank
    assign menu_3 = linklists['footer-the-house']
  endif
-%}

<footer class="q-footer">
  <div class="q-container q-footer__inner">
    <div class="q-footer__columns">
      <div class="q-footer__anchor">
        {%- liquid
          assign footer_logo_tracking = section.settings.footer_logo_letter_spacing | times: 0.01 | append: 'em'
          assign footer_logo_font = 'var(--q-font-display, "Bodoni Moda", Georgia, serif)'
          if section.settings.footer_logo_font_family == 'body'
            assign footer_logo_font = 'var(--q-font-body, "Satoshi", sans-serif)'
          elsif section.settings.footer_logo_font_family == 'mono'
            assign footer_logo_font = 'var(--q-font-mono, monospace)'
          endif
        -%}
        <a
          href="{{ routes.root_url }}"
          class="q-footer__wordmark"
          style="--q-footer-logo-font: {{ footer_logo_font }}; --q-footer-logo-size: {{ section.settings.footer_logo_font_size }}px; --q-footer-logo-weight: {{ section.settings.footer_logo_font_weight }}; --q-footer-logo-tracking: {{ footer_logo_tracking }}; --q-footer-logo-transform: {{ section.settings.footer_logo_text_transform }}; --q-footer-logo-color: {{ section.settings.footer_logo_color }};"
        >
          {{ section.settings.wordmark_text | default: shop.name }}
        </a>
        {%- if section.settings.tagline != blank or settings.tagline != blank -%}
          <p class="q-mono-spec" style="margin: 0; color: var(--q-dark-01);">
            {{ section.settings.tagline | default: settings.tagline }}
          </p>
        {%- endif -%}
        {%- if section.settings.description != blank or shop.description != blank -%}
          <p class="q-body-sm" style="margin: 0; max-width: 360px;">
            {{ section.settings.description | default: shop.description }}
          </p>
        {%- endif -%}
      </div>

      <div class="q-footer__col">
        <h2 class="q-mono-spec" style="margin: 0; color: var(--q-dark-01);">
          {{ section.settings.col_1_heading | default: menu_1.title | upcase }}
        </h2>
        {%- if menu_1 != blank and menu_1.links.size > 0 -%}
          <ul class="q-footer__links">
            {%- for link in menu_1.links -%}
              <li>
                <a href="{{ link.url }}" class="q-body-sm q-link-footer" {% if link.active %}aria-current="page"{% endif %}>
                  {{ link.title }}
                </a>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>

      <div class="q-footer__col">
        <h2 class="q-mono-spec" style="margin: 0; color: var(--q-dark-01);">
          {{ section.settings.col_2_heading | default: menu_2.title | upcase }}
        </h2>
        {%- if menu_2 != blank and menu_2.links.size > 0 -%}
          <ul class="q-footer__links">
            {%- for link in menu_2.links -%}
              <li>
                <a href="{{ link.url }}" class="q-body-sm q-link-footer" {% if link.active %}aria-current="page"{% endif %}>
                  {{ link.title }}
                </a>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>

      <div class="q-footer__col">
        <h2 class="q-mono-spec" style="margin: 0; color: var(--q-dark-01);">
          {{ section.settings.col_3_heading | default: menu_3.title | upcase }}
        </h2>
        {%- if menu_3 != blank and menu_3.links.size > 0 -%}
          <ul class="q-footer__links">
            {%- for link in menu_3.links -%}
              <li>
                <a href="{{ link.url }}" class="q-body-sm q-link-footer" {% if link.active %}aria-current="page"{% endif %}>
                  {{ link.title }}
                </a>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>
    </div>

    <div class="q-footer__bottom">
      <hr class="q-hairline">
      <div class="q-footer__copyright">
        <p class="q-mono-spec" style="margin: 0;">
          {%- assign current_year = 'now' | date: '%Y' -%}
          {%- capture default_copyright -%}© {{ current_year }} {{ shop.name | upcase }}. ALL RIGHTS RESERVED.{%- endcapture -%}
          {{ section.settings.copyright_left | default: default_copyright }}
        </p>
        {%- if section.settings.copyright_right != blank -%}
          <p class="q-mono-spec" style="margin: 0;">
            {{ section.settings.copyright_right }}
          </p>
        {%- endif -%}
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "QIRÉLIA Footer",
  "settings": [
    {
      "type": "text",
      "id": "wordmark_text",
      "label": "Wordmark",
      "default": "QIRÉLIA"
    },
    {
      "type": "header",
      "content": "Brand Wordmark Text Styles"
    },
    {
      "type": "select",
      "id": "footer_logo_font_family",
      "label": "Font family",
      "options": [
        { "value": "display", "label": "Display Serif" },
        { "value": "body", "label": "Body Sans" },
        { "value": "mono", "label": "Monospace" }
      ],
      "default": "display"
    },
    {
      "type": "range",
      "id": "footer_logo_font_size",
      "label": "Font size",
      "min": 16,
      "max": 52,
      "step": 1,
      "unit": "px",
      "default": 28
    },
    {
      "type": "select",
      "id": "footer_logo_font_weight",
      "label": "Font weight",
      "options": [
        { "value": "300", "label": "Light (300)" },
        { "value": "400", "label": "Regular (400)" },
        { "value": "500", "label": "Medium (500)" },
        { "value": "600", "label": "Semi-bold (600)" },
        { "value": "700", "label": "Bold (700)" }
      ],
      "default": "400"
    },
    {
      "type": "range",
      "id": "footer_logo_letter_spacing",
      "label": "Letter spacing (x0.01 em)",
      "min": 0,
      "max": 50,
      "step": 2,
      "default": 16,
      "info": "16 equals 0.16em tracking."
    },
    {
      "type": "select",
      "id": "footer_logo_text_transform",
      "label": "Text case",
      "options": [
        { "value": "uppercase", "label": "Uppercase" },
        { "value": "none", "label": "As typed" },
        { "value": "capitalize", "label": "Capitalize" },
        { "value": "lowercase", "label": "Lowercase" }
      ],
      "default": "uppercase"
    },
    {
      "type": "color",
      "id": "footer_logo_color",
      "label": "Text color",
      "default": "#141414"
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline",
      "default": "PRESENCE, WITHOUT NOISE."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "House summary"
    },
    {
      "type": "header",
      "content": "Menu columns"
    },
    {
      "type": "text",
      "id": "col_1_heading",
      "label": "Column 1 heading",
      "default": "COLLECTIONS"
    },
    {
      "type": "link_list",
      "id": "col_1_menu",
      "label": "Column 1 menu"
    },
    {
      "type": "text",
      "id": "col_2_heading",
      "label": "Column 2 heading",
      "default": "CLIENT CARE"
    },
    {
      "type": "link_list",
      "id": "col_2_menu",
      "label": "Column 2 menu"
    },
    {
      "type": "text",
      "id": "col_3_heading",
      "label": "Column 3 heading",
      "default": "THE HOUSE"
    },
    {
      "type": "link_list",
      "id": "col_3_menu",
      "label": "Column 3 menu"
    },
    {
      "type": "header",
      "content": "Bottom bar"
    },
    {
      "type": "text",
      "id": "copyright_left",
      "label": "Copyright notice override"
    },
    {
      "type": "text",
      "id": "copyright_right",
      "label": "Concentration signature",
      "default": "20% EAU DE PARFUM  ·  30% EXTRAIT DE PARFUM"
    }
  ]
}
{% endschema %}
