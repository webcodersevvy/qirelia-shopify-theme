{%- liquid
  assign archive_col = collections['the-permanent-archive']
  assign reserve_col = collections['the-reserve-editions']
  assign about_page = pages['about'] | default: pages['the-house']
  assign contact_page = pages['contact']
  assign guide_page = pages['format-guide'] | default: pages['format-care-guide']
  assign terms_page = pages['terms'] | default: pages['terms-conditions']
  assign disclaimer_page = pages['disclaimer']
  assign payments_page = pages['payments'] | default: pages['payment-billing']
-%}

<footer class="q-footer">
  <div class="q-container q-footer__inner">
    <div class="q-footer__columns">
      <div class="q-footer__anchor">
        <a href="{{ routes.root_url }}" class="q-footer__wordmark">
          {{ section.settings.wordmark_text | default: shop.name }}
        </a>
        <p class="q-mono-spec" style="margin: 0; color: var(--q-dark-01);">
          {{ section.settings.tagline | default: settings.tagline }}
        </p>
        <p class="q-body-sm" style="margin: 0; max-width: 360px;">
          {{ section.settings.description }}
        </p>
      </div>

      <div class="q-footer__col">
        <h2 class="q-mono-spec" style="margin: 0; color: var(--q-dark-01);">
          {{ section.settings.col_1_heading | default: 'COLLECTIONS' }}
        </h2>
        <ul class="q-footer__links">
          {%- if section.settings.col_1_menu != blank -%}
            {%- for link in section.settings.col_1_menu.links -%}
              <li>
                <a href="{{ link.url }}" class="q-body-sm q-link-footer" {% if link.active %}aria-current="page"{% endif %}>
                  {{ link.title }}
                </a>
              </li>
            {%- endfor -%}
          {%- else -%}
            <li><a href="{{ routes.collections_url }}" class="q-body-sm q-link-footer">All Fragrances</a></li>
            <li><a href="{{ archive_col.url | default: routes.collections_url }}" class="q-body-sm q-link-footer">The Permanent Archive</a></li>
            <li><a href="{{ reserve_col.url | default: routes.collections_url }}" class="q-body-sm q-link-footer">The Reserve Editions</a></li>
            <li><a href="{{ routes.all_products_collection_url }}" class="q-body-sm q-link-footer">Shop All Products</a></li>
          {%- endif -%}
        </ul>
      </div>

      <div class="q-footer__col">
        <h2 class="q-mono-spec" style="margin: 0; color: var(--q-dark-01);">
          {{ section.settings.col_2_heading | default: 'CLIENT CARE' }}
        </h2>
        <ul class="q-footer__links">
          {%- if section.settings.col_2_menu != blank -%}
            {%- for link in section.settings.col_2_menu.links -%}
              <li>
                <a href="{{ link.url }}" class="q-body-sm q-link-footer" {% if link.active %}aria-current="page"{% endif %}>
                  {{ link.title }}
                </a>
              </li>
            {%- endfor -%}
          {%- else -%}
            <li><a href="{{ contact_page.url | default: routes.root_url }}" class="q-body-sm q-link-footer">Contact &amp; Guidance</a></li>
            <li><a href="{{ guide_page.url | default: routes.all_products_collection_url }}" class="q-body-sm q-link-footer">Format &amp; Care Guide</a></li>
            <li><a href="{{ guide_page.url | default: routes.all_products_collection_url }}" class="q-body-sm q-link-footer">Shipping &amp; Class 3 Handling</a></li>
            <li><a href="{{ guide_page.url | default: routes.all_products_collection_url }}" class="q-body-sm q-link-footer">Returns &amp; Sealed Policy</a></li>
            <li><a href="{{ routes.account_url }}" class="q-body-sm q-link-footer">Orders &amp; Tracking</a></li>
            <li><a href="{{ payments_page.url | default: routes.cart_url }}" class="q-body-sm q-link-footer">Payments &amp; Billing</a></li>
          {%- endif -%}
        </ul>
      </div>

      <div class="q-footer__col">
        <h2 class="q-mono-spec" style="margin: 0; color: var(--q-dark-01);">
          {{ section.settings.col_3_heading | default: 'THE HOUSE' }}
        </h2>
        <ul class="q-footer__links">
          {%- if section.settings.col_3_menu != blank -%}
            {%- for link in section.settings.col_3_menu.links -%}
              <li>
                <a href="{{ link.url }}" class="q-body-sm q-link-footer" {% if link.active %}aria-current="page"{% endif %}>
                  {{ link.title }}
                </a>
              </li>
            {%- endfor -%}
          {%- else -%}
            <li><a href="{{ about_page.url | default: routes.collections_url }}" class="q-body-sm q-link-footer">About QIRÉLIA</a></li>
            <li><a href="{{ about_page.url | default: routes.collections_url }}" class="q-body-sm q-link-footer">Olfactory Philosophy</a></li>
            {%- if settings.social_instagram_url != blank -%}
              <li><a href="{{ settings.social_instagram_url }}" class="q-body-sm q-link-footer" target="_blank" rel="noopener">Instagram</a></li>
            {%- else -%}
              <li><a href="{{ routes.search_url }}" class="q-body-sm q-link-footer">Search Archive</a></li>
            {%- endif -%}
            <li><a href="{{ routes.account_url }}" class="q-body-sm q-link-footer">Client Account</a></li>
            <li><a href="{{ terms_page.url | default: routes.root_url }}" class="q-body-sm q-link-footer">Terms &amp; Conditions</a></li>
            <li><a href="{{ disclaimer_page.url | default: routes.root_url }}" class="q-body-sm q-link-footer">Disclaimer</a></li>
          {%- endif -%}
        </ul>
      </div>
    </div>

    <div class="q-footer__bottom">
      <hr class="q-hairline">
      <div class="q-footer__copyright">
        <p class="q-mono-spec" style="margin: 0;">
          {{ section.settings.copyright_left | default: '© 2026 QIRÉLIA PARFUMS. ALL RIGHTS RESERVED.' }}
        </p>
        <p class="q-mono-spec" style="margin: 0;">
          {{ section.settings.copyright_right | default: '20% EAU DE PARFUM  ·  30% EXTRAIT DE PARFUM' }}
        </p>
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "QIRÉLIA Footer",
  "settings": [
    {
      "type": "text",
      "id": "wordmark_text",
      "label": "Wordmark",
      "default": "QIRÉLIA"
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline",
      "default": "PRESENCE, WITHOUT NOISE."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "House summary",
      "default": "QIRÉLIA is a contemporary women’s fragrance house dedicated to olfactory clarity, restrained raw materials, and skin-close presence."
    },
    {
      "type": "header",
      "content": "Menu columns"
    },
    {
      "type": "text",
      "id": "col_1_heading",
      "label": "Column 1 heading",
      "default": "COLLECTIONS"
    },
    {
      "type": "link_list",
      "id": "col_1_menu",
      "label": "Column 1 menu"
    },
    {
      "type": "text",
      "id": "col_2_heading",
      "label": "Column 2 heading",
      "default": "CLIENT CARE"
    },
    {
      "type": "link_list",
      "id": "col_2_menu",
      "label": "Column 2 menu"
    },
    {
      "type": "text",
      "id": "col_3_heading",
      "label": "Column 3 heading",
      "default": "THE HOUSE"
    },
    {
      "type": "link_list",
      "id": "col_3_menu",
      "label": "Column 3 menu"
    },
    {
      "type": "header",
      "content": "Bottom bar"
    },
    {
      "type": "text",
      "id": "copyright_left",
      "label": "Copyright notice",
      "default": "© 2026 QIRÉLIA PARFUMS. ALL RIGHTS RESERVED."
    },
    {
      "type": "text",
      "id": "copyright_right",
      "label": "Concentration signature",
      "default": "20% EAU DE PARFUM  ·  30% EXTRAIT DE PARFUM"
    }
  ]
}
{% endschema %}
