<section class="color-{{ section.settings.color_scheme }} q-color-scheme q-section" style="padding-top: clamp(40px, 5vw, 72px); padding-bottom: clamp(72px, 7.8vw, 112px);">
  <div class="q-container" style="max-width: 820px; margin-inline: auto; display: flex; flex-direction: column; gap: 28px;">
    <h1 class="q-display-xl">{{ page.title }}</h1>
    <hr class="q-hairline">
    <div class="q-body-lg rte">
      {{ page.content }}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Standard Page Content",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ]
}
{% endschema %}
