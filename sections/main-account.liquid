<section class="color-{{ section.settings.color_scheme }} q-color-scheme q-section" style="padding-top: clamp(36px, 4.4vw, 64px); padding-bottom: clamp(72px, 7.8vw, 112px);">
  <div class="q-container" style="display: flex; flex-direction: column; gap: 36px;">
    <div class="q-shop-header__inner" style="align-items: flex-end;">
      <div style="display: flex; flex-direction: column; gap: 8px;">
        <p class="q-mono-spec" style="margin: 0; color: var(--q-neutral-03);">{{ 'customer.account.eyebrow' | t }}</p>
        <h1 class="q-display-xl">{{ 'customer.account.title' | t }}</h1>
        {%- if customer.name != blank or customer.email != blank -%}
          <p class="q-mono-spec" style="margin: 4px 0 0; color: var(--q-dark-01);">
            {{ customer.name }}{% if customer.name != blank and customer.email != blank %} · {% endif %}{{ customer.email }}
          </p>
        {%- endif -%}
      </div>

      <nav class="q-shop-jump-links" aria-label="{{ 'customer.account.title' | t }}">
        <a href="#orders" class="q-mono-spec q-link-footer">{{ 'customer.account.orders_nav' | t }}</a>
        <a href="{{ routes.account_addresses_url }}" class="q-mono-spec q-link-footer">{{ 'customer.account.addresses_nav' | t }}</a>
        <a href="{{ routes.account_logout_url }}" class="q-mono-spec q-link-editorial">{{ 'customer.account.sign_out' | t }}</a>
      </nav>
    </div>

    <hr class="q-hairline">

    <div class="q-principles-grid q-principles-grid--3">
      <div class="q-principle-card q-account-card--highlight">
        <p class="q-mono-spec" style="margin: 0; color: var(--q-dark-01);">
          {{ 'customer.account.active_dispatch_label' | t }}
        </p>
        {%- if customer.orders.size > 0 -%}
          {%- assign latest_order = customer.orders.first -%}
          <h2 class="q-h3">{{ 'customer.account.order_title' | t: name: latest_order.name }}</h2>
          <div>
            <span class="q-status-pill {% if latest_order.fulfillment_status == 'fulfilled' %}q-status-pill--delivered{% endif %}">
              {{ latest_order.fulfillment_status_label }}
            </span>
          </div>
          <p class="q-body-sm" style="margin: 0;">
            {{ latest_order.created_at | time_tag: format: 'date' }} · {{ latest_order.total_net_amount | money_without_trailing_zeros }}
          </p>
          <a href="{{ latest_order.customer_url }}" class="q-mono-spec q-link-editorial" style="margin-top: auto;">
            {{ 'customer.account.view_all_orders' | t }}
          </a>
        {%- else -%}
          <p class="q-body-sm" style="margin: 0;">{{ 'customer.account.no_orders' | t }}</p>
          <a href="{{ routes.collections_url }}" class="q-mono-spec q-link-editorial" style="margin-top: auto;">
            {{ 'customer.account.explore_all' | t }}
          </a>
        {%- endif -%}
      </div>

      <div class="q-principle-card" style="background-color: var(--q-light-01);">
        <p class="q-mono-spec" style="margin: 0; color: var(--q-dark-01);">
          {{ 'customer.account.archive_label' | t }}
        </p>
        <h2 class="q-h3">{{ 'customer.account.saved_signatures' | t }}</h2>
        <p class="q-body-sm" style="margin: 0;">
          {{ 'customer.account.orders_count' | t: count: customer.orders.size }}
        </p>
        <a href="{{ routes.collections_url }}" class="q-mono-spec q-link-editorial" style="margin-top: auto;">
          {{ 'customer.account.explore_all' | t }}
        </a>
      </div>

      <div class="q-principle-card" style="background-color: var(--q-light-01);">
        <p class="q-mono-spec" style="margin: 0; color: var(--q-dark-01);">
          {{ 'customer.account.address_label' | t }}
        </p>
        <h2 class="q-h3">{{ 'customer.account.saved_preferences' | t }}</h2>
        {%- if customer.default_address != blank -%}
          <div class="q-body-sm">{{ customer.default_address | format_address }}</div>
        {%- else -%}
          <p class="q-body-sm" style="margin: 0;">{{ 'customer.account.no_address' | t }}</p>
        {%- endif -%}
        <a href="{{ routes.account_addresses_url }}" class="q-mono-spec q-link-editorial" style="margin-top: auto;">
          {{ 'customer.account.manage_addresses' | t }}
        </a>
      </div>
    </div>

    <div id="orders" style="display: flex; flex-direction: column; gap: 20px; padding-top: 16px;">
      <div style="display: flex; align-items: baseline; justify-content: space-between; gap: 16px; flex-wrap: wrap;">
        <h2 class="q-h2">{{ 'customer.account.orders_nav' | t }}</h2>
        <span class="q-mono-spec">{{ 'customer.account.orders_count' | t: count: customer.orders.size }}</span>
      </div>

      {% paginate customer.orders by 10 %}
        {%- if customer.orders.size > 0 -%}
          {%- for order in customer.orders -%}
            <article class="q-order-card">
              <div class="q-order-card__meta">
                <div style="display: flex; flex-direction: column; gap: 4px;">
                  <a href="{{ order.customer_url }}" class="q-h3" style="text-decoration: none;">
                    {{ 'customer.account.order_title' | t: name: order.name }}
                  </a>
                  <p class="q-mono-spec" style="margin: 0;">
                    {{ order.created_at | time_tag: format: 'date' }}
                  </p>
                </div>

                <div style="display: flex; align-items: center; gap: 12px; flex-wrap: wrap;">
                  <span class="q-status-pill">{{ order.financial_status_label }}</span>
                  <span class="q-status-pill {% if order.fulfillment_status == 'fulfilled' %}q-status-pill--delivered{% endif %}">
                    {{ order.fulfillment_status_label }}
                  </span>
                  <span class="q-h4 q-tnum">{{ order.total_net_amount | money_with_currency }}</span>
                </div>
              </div>
            </article>
          {%- endfor -%}

          {%- if paginate.pages > 1 -%}
            <nav style="display: flex; align-items: center; justify-content: space-between; padding-top: 24px; border-top: var(--q-hairline);" aria-label="{{ 'general.pagination.label' | t }}">
              <div>
                {%- if paginate.previous -%}
                  <a href="{{ paginate.previous.url }}" class="q-mono-spec q-link-editorial">{{ 'general.pagination.previous' | t }}</a>
                {%- endif -%}
              </div>
              <span class="q-mono-spec">{{ 'general.pagination.page' | t: number: paginate.current_page }}</span>
              <div>
                {%- if paginate.next -%}
                  <a href="{{ paginate.next.url }}" class="q-mono-spec q-link-editorial">{{ 'general.pagination.next' | t }}</a>
                {%- endif -%}
              </div>
            </nav>
          {%- endif -%}
        {%- else -%}
          <div class="q-order-card">
            <p class="q-body" style="margin: 0;">{{ 'customer.account.no_orders' | t }}</p>
            <div>
              <a href="{{ routes.collections_url }}" class="q-btn q-btn--primary">
                {{ 'general.404.cta' | t }}
              </a>
            </div>
          </div>
        {%- endif -%}
      {% endpaginate %}
    </div>

    <div class="q-account-strip">
      <div style="display: flex; flex-direction: column; gap: 4px;">
        <p class="q-mono-spec" style="margin: 0; color: var(--q-dark-01);">{{ 'customer.account.auth_strip_title' | t }}</p>
        <p class="q-body-sm" style="margin: 0;">{{ 'customer.account.auth_strip_copy' | t }}</p>
      </div>

      <div style="display: flex; align-items: center; gap: 12px; flex-wrap: wrap;">
        <a href="{{ routes.account_addresses_url }}" class="q-btn q-btn--secondary">
          {{ 'customer.account.addresses_nav' | t }}
        </a>
        <a href="{{ routes.account_logout_url }}" class="q-btn q-btn--primary">
          {{ 'customer.account.sign_out' | t }}
        </a>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Client Account Dashboard",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ]
}
{% endschema %}
